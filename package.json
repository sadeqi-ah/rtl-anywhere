{
  "name": "rtl-anywhere",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Userscript that makes any text on any website right-to-left with one shortcut.",
  "license": "MIT",
  "author": "sadeqi-ah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadeqi-ah/rtl-anywhere.git"
  },
  "keywords": [
    "userscript",
    "tampermonkey",
    "rtl",
    "persian",
    "arabic",
    "hebrew"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.ts && node test/security-scan.mjs",
    "test:security": "node test/security-scan.mjs",
    "test:smoke": "node test/smoke-runner.mjs",
    "check:bundle": "node build.mjs && git diff --exit-code -- rtl-anywhere.user.js",
    "dev:harness": "node build.mjs && echo 'Open test/harness.html in a browser'",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc -p tsconfig.json && pnpm test && node build.mjs && git diff --exit-code -- rtl-anywhere.user.js && node test/smoke-runner.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.27.0"
}
